rules_version = '2';

// * Public pages show images through server-signed URLs, which bypass these
// * rules. Only sellers (their own stores) and admins use the browser SDK, so
// * everything starts closed. Tests: npm run test:rules
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
