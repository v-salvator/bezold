rules_version = '2';

// * Public pages read through the Admin SDK on the server, which bypasses these
// * rules. The browser SDK is only used by signed-in sellers on their own data
// * and by admins, so everything starts closed. Tests: npm run test:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // * custom claim set by /api/admin/set-claim (same check as verifyAdminToken)
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // * one rules file serves both NEXT_PUBLIC_ENV_VERSION environments
    function isUserCollection(collectionName) {
      return collectionName in ['mockUser', 'prodUser'];
    }

    function isStoreCollection(collectionName) {
      return collectionName in ['mockStore', 'prodStore'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // * user docs hold seller contact info (phone / LINE / email) — only the
    // * user and admins may see them; public pages get it via the member-gated
    // * /api/stores/[storeId]/contact route
    match /{collectionName}/{userId} {
      allow read: if isUserCollection(collectionName)
        && (isSelf(userId) || isAdmin());
      // * self: signup / editUserById upsert (id = uid)
      // * admin: createUserDoc uses addDoc, so the id is random
      allow create: if isUserCollection(collectionName)
        && (isSelf(userId) || isAdmin());
      allow update: if isUserCollection(collectionName)
        && (isAdmin()
          || (isSelf(userId) && !changedKeys().hasAny(['createTime'])));
    }

    // * the fields SellForm sends to createStoreDoc — nothing else on create
    function sellFormKeys() {
      return ['storeName', 'city', 'district', 'location', 'description',
        'price', 'priceNegotiable', 'category', 'areaPing', 'monthlyRent',
        'equipment', 'tags', 'currency', 'user', 'images', 'status',
        'createTime', 'updateTime'];
    }

    // * a new listing always enters review: no tags (admin-only, e.g.
    // * RECOMMENDED), no photos yet (uploaded after the doc exists), and
    // * server timestamps
    function isNewSellerListing() {
      let data = request.resource.data;
      return signedIn()
        && data.keys().hasOnly(sellFormKeys())
        && data.user == request.auth.uid
        && data.status == 'pending'
        && data.tags == []
        && data.images == []
        && data.createTime == request.time
        && data.updateTime == request.time;
    }

    match /{collectionName}/{storeId} {
      // * owner: /my-listings query (where user == uid) and the edit page
      // * admin: every list in /admin, drafts included
      allow read: if isStoreCollection(collectionName)
        && (isAdmin() || (signedIn() && resource.data.user == request.auth.uid));
      allow create: if isStoreCollection(collectionName)
        && (isAdmin() || isNewSellerListing());
      // * the app deletes through the Admin SDK (DELETE /api/stores/[storeId])
      allow delete: if isStoreCollection(collectionName) && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
