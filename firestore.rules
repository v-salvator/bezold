rules_version = '2';

// * Public pages read through the Admin SDK on the server, which bypasses these
// * rules. The browser SDK is only used by signed-in sellers on their own data
// * and by admins, so everything starts closed. Tests: npm run test:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
